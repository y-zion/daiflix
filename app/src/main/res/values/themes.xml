<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Daiflix Theme - Netflix-inspired dark theme -->
    <style name="Theme.Daiflix" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF0B0B0B</item>
        <item name="android:windowBackground">#FF0B0B0B</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Player Theme - Pure black for fullscreen video -->
    <style name="Theme.Daiflix.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
