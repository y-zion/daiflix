<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Daiflix Theme - Netflix-inspired dark theme -->
    <style name="Theme.Daiflix" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF0D0D0D</item>
        <item name="android:statusBarColor">#FF0D0D0D</item>
        <item name="android:navigationBarColor">#FF0D0D0D</item>
    </style>

    <!-- Player Theme - Pure black for fullscreen video -->
    <style name="Theme.Daiflix.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
